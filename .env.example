# Set these in Vercel (and in a local .env.local for manual runs). Never commit real secrets.
# Validated with zod when the server first uses them; a missing variable fails with a clear message.

# Server use only (the name is kept for compatibility with the existing Vercel env).
# Either the project URL or the REST URL (a trailing /rest/v1/ is stripped).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# One of these (server-only).
SUPABASE_SECRET_KEY=YOUR_SERVER_ONLY_SECRET_KEY
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# 32 characters or more.
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# (Events) Read ONCE by scripts/bootstrap-events.mjs (the EDC staff password); the app itself no longer reads them:
# staff passwords, the lead passcode and join links live in the database and a lead sets them in the app.
APP_SHARED_PASSWORD_HASH_B64=BASE64_ENCODED_BCRYPT_HASH
# APP_SHARED_PASSWORD=the-event-password

# Optional. PHASE2: the fallback display time zone until every screen reads its event's.
EVENT_TIMEZONE=America/New_York

# (Events) The old EDC join link, read ONCE by scripts/bootstrap-events.mjs. New links: POST /api/events/:id/join-link.
INVITE_CODE_SHA256=SHA256_HEX_OF_THE_JOIN_CODE
INVITE_EXPIRES_AT=2026-11-09T12:00:00Z

# Web Push (lock-screen alerts). Already set in production. All three switch push on; missing or invalid →
# push is off, silently (no banner, no pushes). Generate a pair once with:
#   node -e "const k=require('web-push').generateVAPIDKeys();console.log(k.publicKey+'\n'+k.privateKey)"
# Changing the pair makes every device subscribe again (automatic, on its next open).
VAPID_PUBLIC_KEY=BASE64URL_PUBLIC_KEY
VAPID_PRIVATE_KEY=BASE64URL_PRIVATE_KEY
VAPID_SUBJECT=mailto:someone@example.com
# Optional: the same public key for the browser at build time. The app also reads it from the server.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=BASE64URL_PUBLIC_KEY
