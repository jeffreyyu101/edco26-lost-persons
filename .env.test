# Local-only test environment (committed on purpose). Every value here only works against the local
# Supabase stack started by `supabase start` (supabase/config.toml, project_id lp-local).
# Test helpers, scripts/db-reset.sh and the seed refuse to run unless the Supabase URL host is
# 127.0.0.1 or localhost. Never copy production values into this file. Never read .env.local in tests.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
SESSION_SECRET=local-test-session-secret-not-for-production-0123456789
APP_SHARED_PASSWORD=test-event-password
EVENT_TIMEZONE=America/New_York
PORT=3100
# Web Push (F4): a key pair generated for local tests only (web-push generateVAPIDKeys). Never use it anywhere
# else. LP_PUSH_ALLOW_LOCAL lets subscriptions point at a local fake push service (https://127.0.0.1); the
# server honours it only while the Supabase URL is local, so it can never apply in production.
VAPID_PUBLIC_KEY=BEaPyhQXb8N_tL40dgifi5XzkMxfyb9Fq-fyPyhDqG_owTqxDe7FG9PoHwIYVWkQFVaeTf0nbxe42jSDHlw0w28
VAPID_PRIVATE_KEY=on0i8w6NSMAFsfPLVnh20y27lEIG9ASp-m-64EnaLIU
VAPID_SUBJECT=mailto:lp-tests@example.invalid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BEaPyhQXb8N_tL40dgifi5XzkMxfyb9Fq-fyPyhDqG_owTqxDe7FG9PoHwIYVWkQFVaeTf0nbxe42jSDHlw0w28
LP_PUSH_ALLOW_LOCAL=1
