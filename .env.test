# Local-only test environment (committed on purpose). Every value here only works against the local
# Supabase stack started by `supabase start` (supabase/config.toml, project_id lp-local).
# Test helpers, scripts/db-reset.sh and the seed refuse to run unless the Supabase URL host is
# 127.0.0.1 or localhost. Never copy production values into this file. Never read .env.local in tests.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
SESSION_SECRET=local-test-session-secret-not-for-production-0123456789
APP_SHARED_PASSWORD=test-event-password
EVENT_TIMEZONE=America/New_York
PORT=3100
