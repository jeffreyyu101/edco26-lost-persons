{
  "name": "edco26-lost-persons",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --port ${PORT:-3100}",
    "build": "next build && node scripts/sw-manifest.mjs",
    "start": "next start --port ${PORT:-3100}",
    "build:test": "node scripts/with-test-env.mjs next build",
    "start:test": "node scripts/with-test-env.mjs next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint --max-warnings=0 .",
    "test": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "test:e2e": "playwright test",
    "db:reset": "bash scripts/db-reset.sh",
    "db:verify-migration": "bash scripts/verify-migration.sh",
    "assets": "node scripts/generate-assets.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@radix-ui/themes": "3.3.0",
    "@supabase/supabase-js": "2.119.0",
    "bcryptjs": "3.0.3",
    "idb-keyval": "6.3.0",
    "jose": "6.2.15",
    "lucide-react": "1.70.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "web-push": "3.6.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "3.6.4",
    "axe-core": "4.14.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "fake-indexeddb": "6.2.7",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
